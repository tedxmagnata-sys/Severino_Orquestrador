# =====================================================================
# VENDEDOR.SEVERINOBOT.COM - info-produto Severino Vendedor IA (porta 3334)
# Vitrine do produto no subdominio dedicado (padrao produto.severinobot.com)
# =====================================================================
server {
    if ($host = vendedor.severinobot.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.vendedor.severinobot.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name vendedor.severinobot.com www.vendedor.severinobot.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name vendedor.severinobot.com www.vendedor.severinobot.com;
    ssl_certificate /etc/letsencrypt/live/severinobot.com-0001/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/severinobot.com-0001/privkey.pem; # managed by Certbot
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3338;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

}