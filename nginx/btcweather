server {
    if ($host = www.btcweatherpanel.com) {
        return 301 https://$host$request_uri;
    }
    if ($host = btcweatherpanel.com) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name btcweatherpanel.com www.btcweatherpanel.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name btcweatherpanel.com www.btcweatherpanel.com;

    ssl_certificate /etc/letsencrypt/live/severinobot.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/severinobot.com-0001/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3340;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}