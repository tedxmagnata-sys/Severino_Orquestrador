  console.log(`🌐 http://localhost:${PORT}/ → Redireciona para /btc-weather-panel/`);
  console.log(`🦾 http://localhost:${PORT}/severino-ia/ → Severino Consultor IA`);
  console.log(`📡 API Licenças: /api/license/*`);
  console.log(`📡 API Eventos: /api/event | /api/cohort`);
  console.log(`🤖 Telegram Bot: @btcweatherpanel_bot`);
