function cleanupStaleSessions() {
  const now = Date.now();
  for (const [sid, sess] of telemetryStats.sessions.entries()) {
    if (now - sess.lastSeen > 90000) { // 90 seconds timeout
      telemetryStats.sessions.delete(sid);
    }
  }
}
