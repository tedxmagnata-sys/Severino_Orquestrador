# =====================================================================
# SEVERINOBOT.COM — Ecossistema Severino (independente do BTC)
# severinobot.com / www / raiz + /ecosistema + /api/ecosystem + /agendabarber + /leadbook
# =====================================================================
server {
    if ($host = www.severinobot.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = severinobot.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name severinobot.com www.severinobot.com 187.127.42.146;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name severinobot.com www.severinobot.com;
    ssl_certificate /etc/letsencrypt/live/severinobot.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/severinobot.com/privkey.pem; # managed by Certbot
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50M;

    # Orquestrador do Ecossistema (porta 3335) — painel + API
    location /ecosistema/ {
        proxy_pass http://127.0.0.1:3335/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API do ecossistema (independente do btcweather)
    location /api/ecosystem/ {
        proxy_pass http://127.0.0.1:3335;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AgendaBarber (Severino Barber) — porta 3341
    location /agendabarber/ {
        proxy_pass http://127.0.0.1:3341/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # >>> LEADBOOK >>>
    location /leadbook/ {
        proxy_pass http://127.0.0.1:3336;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:3334;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

