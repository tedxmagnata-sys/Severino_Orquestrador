                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);">ðŸ’Ž LINK CHECKOUT - PLANO ELITE (R$ 97)</label>
                    <input type="text" id="admin-link-elite-input" placeholder="https://..." style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.8rem;">
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);">ðŸ”‘ CHAVE MESTRA DE ATIVAÃ‡ÃƒO VIP</label>
                    <input type="text" id="admin-vip-key-input" placeholder="SECRET_KEY (config admin)" style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: var(--color-sunny); font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; text-transform: uppercase;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);">âœˆï¸ ID DO GRUPO/CANAL TELEGRAM (Ex: -1002048592398)</label>
                    <input type="text" id="admin-tg-chat-input" placeholder="-100..." style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.8rem;">
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);">ðŸ’¬ ID DO GRUPO WHATSAPP (Ex: 1203632198592@g.us)</label>
                    <input type="text" id="admin-wa-group-input" placeholder="1203..." style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.8rem;">
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.2rem;">
                    <input type="checkbox" id="admin-alerts-enabled-checkbox" style="cursor: pointer; width: 16px; height: 16px;">
                    <label for="admin-alerts-enabled-checkbox" style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); cursor: pointer;">ðŸ”” Habilitar Push Notifications AutomÃ¡ticas</label>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);">ðŸ” GOOGLE CLIENT ID (OAuth do login com Google no teste grÃ¡tis)</label>
                    <input type="text" id="admin-google-client-input" placeholder="XXXX.apps.googleusercontent.com" style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: var(--color-sunny); font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;">
                </div>

                <!-- REALTIME TELEMETRY CARD -->
                <div style="background: rgba(0,230,118,0.05); border: 1px solid rgba(0,230,118,0.2); border-radius: 10px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.72rem; font-weight: 800; color: #00e676; display: flex; align-items: center; gap: 6px;">
                            <span class="action-pulse" style="background: #00e676; width: 8px; height: 8px; display: inline-block; border-radius: 50%;"></span> TELEMETRIA EM TEMPO REAL
                        </span>
                        <button id="btn-refresh-telemetry" style="background: transparent; border: none; color: var(--text-secondary); font-size: 0.7rem; cursor: pointer;">ðŸ”„ Atualizar</button>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; text-align: center;">
                        <div style="background: rgba(0,0,0,0.5); padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border-color);">
                            <span style="font-size: 0.65rem; color: var(--text-secondary); display: block;">USUÃRIOS ONLINE AGORA</span>
                            <strong id="metric-active-now" style="font-size: 1.1rem; color: #00e676; font-family: 'JetBrains Mono', monospace;">0</strong>
                        </div>
                        <div style="background: rgba(0,0,0,0.5); padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border-color);">
                            <span style="font-size: 0.65rem; color: var(--text-secondary); display: block;">VISITANTES ÃšNICOS HOJE</span>
                            <strong id="metric-today-visits" style="font-size: 1.1rem; color: var(--color-sunny); font-family: 'JetBrains Mono', monospace;">0</strong>
                        </div>
                        <div style="background: rgba(0,0,0,0.5); padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border-color);">
                            <span style="font-size: 0.65rem; color: var(--text-secondary); display: block;">ALERTAS ATIVOS NO SISTEMA</span>
                            <strong id="metric-active-alerts" style="font-size: 1.1rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0</strong>
                        </div>
                        <div style="background: rgba(0,0,0,0.5); padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border-color);">
                            <span style="font-size: 0.65rem; color: var(--text-secondary); display: block;">DESKTOP / MOBILE</span>
                            <strong id="metric-device-ratio" style="font-size: 0.8rem; color: var(--text-secondary); font-family: 'JetBrains Mono', monospace;">- / -</strong>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                    <button id="btn-save-admin" class="btn btn-primary btn-full" data-i18n="admin_save_btn">Salvar ConfiguraÃ§Ãµes</button>
                </div>
                <span id="admin-save-success" class="copy-success-msg hidden" style="text-align: center;" data-i18n="admin_save_success">âœ“ ConfiguraÃ§Ãµes salvas e aplicadas com sucesso!</span>
            </div>
        </div>
    </div>

    <!-- GOOGLE SIGNUP / VIP INVITE MODAL -->
    <div id="invite-signup-modal" class="modal-overlay hidden">
        <div class="modal-content glass" style="max-width: 440px; padding: 1.5rem;">
            <button class="modal-close">&times;</button>
            <div class="modal-header" style="text-align: center; display: flex; flex-direction: column; gap: 0.35rem; align-items: center;">
                <span class="modal-badge" style="background: linear-gradient(135deg, var(--color-sunny), var(--color-cloudy)); color: #000; font-weight: 800; font-size: 0.68rem; padding: 3px 8px; border-radius: 20px;" data-i18n="invite_badge">ðŸŽ CONVITE VIP EXCLUSIVO</span>
                <h2 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin-top: 0.25rem;" data-i18n="invite_title">Ativar Acesso VitalÃ­cio GrÃ¡tis</h2>
                <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;" data-i18n="invite_desc">VocÃª foi convidado para testar e usar o BTC Weather Panel com acesso VIP ilimitado e sem cobranÃ§as.</p>
            </div>
            <div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem; align-items: center; margin-top: 0.75rem; width: 100%;">
                <p style="font-size: 0.7rem; color: var(--text-secondary); text-align: center; line-height: 1.45; margin: 0;" data-i18n="invite_body">
                    Desbloqueie sinais em tempo real, todas as estaÃ§Ãµes (15M, 1H, 4H) e termÃ´metro completo. Basta fazer cadastro rÃ¡pido com sua conta do Google e comprometer-se a responder feedbacks.
                </p>
                
                <div style="width: 100%; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.25rem;">
                    <button id="btn-google-signup" class="btn btn-secondary btn-full" style="background: #fff; color: #000; font-weight: 700; border: none; font-size: 0.8rem; padding: 0.65rem; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 8px; transition: transform 0.2s ease;">
                        <svg width="16" height="16" viewBox="0 0 18 18" style="flex-shrink: 0;">
                            <path fill="#4285F4" d="M17.64 9.2c0-.63-.06-1.25-.16-1.84H9v3.47h4.84c-.21 1.12-.84 2.07-1.79 2.7v2.24h2.9c1.69-1.55 2.69-3.84 2.69-6.57z"/>
                            <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.23l-2.9-2.24c-.8.54-1.84.87-3.06.87-2.35 0-4.34-1.58-5.05-3.72H.95v2.3C2.43 15.89 5.5 18 9 18z"/>
                            <path fill="#FBBC05" d="M3.95 10.68c-.18-.54-.28-1.12-.28-1.68s.1-1.14.28-1.68V5.02H.95C.34 6.22 0 7.57 0 9s.34 2.78.95 3.98l3-2.3z"/>
                            <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35L15 2.4C13.46.99 11.42 0 9 0 5.5 0 2.43 2.11.95 5.02l3 2.3c.71-2.14 2.7-3.74 5.05-3.74z"/>
                        </svg>
                        <span data-i18n="invite_google_btn">Registrar com o Google</span>
                    </button>                    
                    <label style="display: flex; align-items: flex-start; gap: 6px; cursor: pointer; user-select: none;">
                        <input type="checkbox" id="consent-feedback-checkbox" checked style="margin-top: 2px; cursor: pointer;">
                        <span style="font-size: 0.62rem; color: var(--text-secondary); line-height: 1.3;" data-i18n="invite_consent">
                            Aceito me cadastrar gratuitamente e concordo em responder feedbacks sobre a usabilidade e sinais operacionais para aprimorar o painel.
                        </span>
                    </label>
                </div>

                <div id="google-loading" class="hidden" style="text-align: center; margin-top: 0.1rem; width: 100%;">
                    <span style="font-size: 0.7rem; color: var(--color-sunny); font-family: 'JetBrains Mono', monospace; display: flex; align-items: center; justify-content: center; gap: 6px;">
                        ðŸ”„ Autenticando com o Google...
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- CUSTOM PRICE ALERTS MODAL -->
    <div id="price-alert-modal" class="modal-overlay hidden">
        <div class="modal-content glass" style="max-width: 460px;">
            <button class="modal-close">&times;</button>
            <div class="modal-header">
                <span class="modal-badge" style="color: var(--color-sunny);" data-i18n="alert_badge">ðŸŽ¯ ALERTAS PERSONALIZADOS</span>
                <h2 data-i18n="alert_title">Alerta de PreÃ§o do Bitcoin</h2>
                <p data-i18n="alert_desc">Receba avisos visuais, sonoros e push nativos quando o BTC atingir seu alvo.</p>
            </div>
            <div class="modal-body" style="display: flex; flex-direction: column; gap: 1.25rem;">
                
                <!-- Create Alert Form -->
                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: 0.85rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);" data-i18n="alert_target_label">VALOR ALVO DO BTC (USD)</label>
                        <div style="position: relative; display: flex; align-items: center;">
                            <span style="position: absolute; left: 12px; color: var(--text-secondary); font-weight: 700; font-family: 'JetBrains Mono', monospace;">$</span>
                            <input type="number" id="alert-price-input" placeholder="Ex: 68500" step="100" style="width: 100%; background: #000; border: 1px solid var(--border-color); padding: 0.6rem 0.6rem 0.6rem 2rem; border-radius: 8px; color: #fff; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700;">
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);" data-i18n="alert_cond_label">CONDIÃ‡ÃƒO DE DISPARO</label>
                        <select id="alert-condition-select" style="background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.8rem; cursor: pointer;">
                            <option value="above"><span data-i18n="alert_above">ðŸŸ¢ PreÃ§o subir e passar de (â‰¥)</span></option>
                            <option value="below"><span data-i18n="alert_below">ðŸ”´ PreÃ§o cair e passar de (â‰¤)</span></option>
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary);" data-i18n="alert_email_label">E-MAIL PARA ALERTA (OPCIONAL)</label>
                        <input type="email" id="alert-email-input" placeholder="seuemail@exemplo.com" style="width: 100%; background: #000; border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 8px; color: #fff; font-family: inherit; font-size: 0.8rem;">
                    </div>

                    <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
                        <button id="btn-create-alert" class="btn btn-primary" style="flex: 1;">
                            <i data-lucide="plus-circle"></i> <span data-i18n="alert_create_btn">Criar Alerta</span>
                        </button>
                        <button id="btn-test-alert" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.6rem; white-space: nowrap; border-color: var(--color-sunny); color: var(--color-sunny);">
                            🧠ª <span data-i18n="alert_test_btn">Testar Disparo (Telegram + E-mail)</span>
                        </button>
                    </div>
                    <span id="test-alert-status" class="copy-success-msg hidden" style="text-align: center; font-size: 0.72rem;"></span>
                </div>

                <!-- Active Alerts List -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); display: flex; justify-content: space-between; align-items: center;">
                        <span data-i18n="alert_list_label">SEUS ALERTAS CONFIGURADOS (MÃX 5)</span>
                        <span id="alerts-count-label" style="font-size: 0.68rem; color: var(--color-sunny);">0/5 ativos</span>
                    </label>
                    <div id="alerts-list-container" style="max-height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; padding-right: 2px;">
                        <div style="text-align: center; color: var(--text-secondary); font-size: 0.75rem; padding: 1rem 0;" data-i18n="alert_list_empty">
                            Nenhum alerta configurado no momento.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="i18n.js?v=3"></script>
    <script src="themes.js?v=2"></script>
    <script src="index.js?v=40"></script>
</body>
</html>

