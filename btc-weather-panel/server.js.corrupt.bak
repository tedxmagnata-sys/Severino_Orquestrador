const ST_STATE_PATH = path.join(DATA_DIR, 'st_trader_state.json');
const ST_TF = { '15M':'15m','1H':'1h','4H':'4h','1D':'1d','3D':'3d','1W':'1w','1M':'1M' };
const ST_TF_LABEL = { '15M':'15M','1H':'1H','4H':'4H','1D':'Diário','3D':'3 Dias','1W':'Semanal','1M':'Mensal' };
